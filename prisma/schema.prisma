// Ella's Babysitting App — data model spec
//
// TRUST MODEL (decided 2026-08-18): this is a closed, local app for Bundeena
// / Maianbar — not an open marketplace. No formal background-check
// requirement. The trust gate is admin approval: Ella (or another admin)
// manually approves every account, parent or sitter, before they can book
// or message. Sitter *browsing* and availability are public (no approval
// needed to look), but transacting requires an approved account.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  SITTER
  ADMIN
}

// Replaces the earlier "VerificationStatus" concept. This now represents
// Ella's manual approval, not a background-check outcome — background
// checks are explicitly not required for this closed local app, but the
// fields below stay optional in case a future admin wants to record one
// for a specific sitter.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  emailVerified  DateTime?      // no longer set by anything — password auth has no email-verification step
  image          String?        // Auth.js adapter expects this field to exist
  name           String?        // null for accounts created by magic-link sign-in with no prior /join or /sitters/apply form (e.g. ADMIN_EMAILS auto-promotion)
  phone          String?
  suburb         String?        // "Bundeena" | "Maianbar" — informal, not enforced
  role           Role           @default(PARENT)
  referralNote   String?        // "how does Ella know you" — shown to Ella in the approval queue
  password       String?        // bcrypt hash (src/lib/password.ts) — null until set via signup or the forgot-password flow (src/app/signin/forgot-password)

  // Admin approval gate — required before a user can book, message, or
  // (for sitters) appear as bookable. Signing up does not grant access.
  approvalStatus ApprovalStatus @default(PENDING)
  approvedById   String?        // admin User id who approved/rejected
  approvedAt     DateTime?

  createdAt      DateTime       @default(now())

  // Relations
  sitterProfile SitterProfile?
  bookingsAsParent  Booking[]      @relation("ParentBookings")
  messagesSent      Message[]      @relation("MessagesSent")
  pushSubscriptions PushSubscription[]
  accounts          Account[]
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
}

// Single-use tokens for the forgot/set-password flow (src/lib/actions.ts).
// Only the sha256 hash of the token is stored, so a DB read alone can't be
// used to reset someone's password.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// --- Auth.js (NextAuth v5) Prisma adapter models ---
// No longer wired up to a provider (auth.ts uses Credentials + JWT
// sessions, not the Prisma adapter) — kept unused rather than dropped, in
// case an OAuth provider is added later. Required schema shape:
// https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SitterProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])

  // Bio/rate/experience are filled in via the self-service profile editor
  // (src/app/dashboard/profile) after Ella approves the sitter — null until
  // then. Signup itself only collects safety/identity info (below).
  bio                String?
  hourlyRateCents    Int?
  yearsExperience    Int?

  // "Best with" age range — the ages this sitter is most comfortable
  // caring for, distinct from yearsExperience above. Both null until set
  // in the self-service profile editor. Powers the /sitters age filter.
  bestWithAgeMin     Int?
  bestWithAgeMax     Int?
  // Self-declared service tags, filterable on /sitters.
  offersSchoolPickup Boolean  @default(false)
  offersEveningCare  Boolean  @default(false)

  // Safety/identity info, collected at signup (src/lib/actions.ts).
  dateOfBirth             DateTime?
  emergencyContact1Name   String?
  emergencyContact1Phone  String?
  emergencyContact2Name   String?
  emergencyContact2Phone  String?
  // Required only when dateOfBirth implies under 16 at signup.
  parentGuardianName      String?
  parentGuardianPhone     String?
  termsAcceptedAt         DateTime?

  // Working with Children Check — self-declared only, no registry
  // verification against NSW's WWCC number lookup. Mandatory for sitters
  // 18+ (checkbox required at signup, see src/lib/actions.ts); editable
  // later in the self-service profile editor so a renewed number/expiry
  // can be updated. Not required under 18.
  wwccConfirmed      Boolean   @default(false)
  wwccNumber         String?
  wwccExpiry         DateTime?

  // Nationally Recognised First Aid (HLTAID011) — optional, self-declared.
  firstAidCertified  Boolean   @default(false)

  // Free text for any other certificates — name + expiry, sitter's own
  // wording rather than a structured list (kept simple for this app).
  otherCertifications String?

  // Optional, NOT required for this app. Kept in case a specific situation
  // (e.g. a sitter who isn't personally known to Ella) calls for one later.
  backgroundCheckAt  DateTime?
  idVerifiedAt       DateTime?

  stripeConnectAccountId String?        // Stripe Connect Express account for payouts

  availability       SitterAvailability[]
  bookings           Booking[]          @relation("SitterBookings")
  reviews            Review[]           @relation("SitterReviews")

  avgRating          Float?             @default(0)
  reviewCount        Int                @default(0)
}

// A sitter's recurring weekly availability, used by the date/time search
// (src/lib/sitters.ts). Plain integers rather than DateTime/Time — a
// recurring weekly slot has no calendar date to anchor to, which sidesteps
// timezone handling entirely.
model SitterAvailability {
  id              String        @id @default(cuid())
  sitterProfileId String
  sitterProfile   SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)

  dayOfWeek       Int           // 0=Sun .. 6=Sat
  startMinute     Int           // minutes since midnight
  endMinute       Int           // minutes since midnight

  createdAt       DateTime      @default(now())
}

model Booking {
  id            String        @id @default(cuid())
  parentId      String
  parent        User          @relation("ParentBookings", fields: [parentId], references: [id])
  sitterId      String
  sitter        SitterProfile @relation("SitterBookings", fields: [sitterId], references: [id])

  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(REQUESTED)
  notes         String?
  numChildren   Int           @default(1)

  messages      Message[]
  payment       Payment?
  review        Review?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User     @relation("MessagesSent", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
  readAt    DateTime?
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])

  amountCents       Int
  platformFeeCents  Int
  sitterPayoutCents Int

  status            PaymentStatus @default(PENDING)
  stripePaymentIntentId String?   // Stripe Connect payout intent (sitterPayoutCents) — not used by the flat booking fee below
  squarePaymentId   String?       // Square Payments API id for the flat platform booking fee (src/lib/payments.ts)
  createdAt         DateTime      @default(now())
}

model Review {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id])
  sitterId  String
  sitter    SitterProfile @relation("SitterReviews", fields: [sitterId], references: [id])

  rating    Int           // 1-5
  comment   String?
  createdAt DateTime      @default(now())
}

// Web push subscriptions — see PWA push notification note in README.
// iOS only receives these after the user adds the app to their home screen
// (iOS 16.4+). Design onboarding to prompt for that install step.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// "Sitter Sisters Club" newsletter — footer signup box (src/components/footer.tsx).
// Deliberately separate from User: anyone can subscribe without an account.
model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  subscribedAt DateTime @default(now())
}
