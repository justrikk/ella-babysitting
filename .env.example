# Copy to .env and fill in real values. See README "Getting started (real
# backend)" for where each of these comes from.

# Supabase Postgres — pooled connection (Supavisor, port 6543, ?pgbouncer=true).
# Used by the app at runtime (src/lib/prisma.ts). From Supabase dashboard:
# Project Settings -> Database -> Connection string -> Transaction pooler.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct (unpooled, port 5432) connection. Used only by
# `prisma migrate` (see prisma.config.ts) — PgBouncer's transaction pooling
# doesn't support the prepared statements migrations need.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Auth.js session/token encryption secret. Generate with:
#   npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET=""

# Resend — sends the magic-link sign-in emails (src/auth.ts). Get a key at
# https://resend.com/api-keys. EMAIL_FROM must be on a domain verified in
# Resend (resend.dev works for testing without your own domain).
RESEND_API_KEY=""
EMAIL_FROM="Ella's Babysitting <onboarding@resend.dev>"

# Comma-separated list of emails that get auto-promoted to ADMIN + APPROVED
# on their first sign-in (src/auth.ts). This is how Ella gets into her own
# approval queue without needing to approve herself.
ADMIN_EMAILS="ella@example.com"

# Square — charges the $4.95 booking fee (src/lib/payments.ts). From
# https://developer.squareup.com/apps -> your app -> Credentials/Locations.
# Use "sandbox" while testing; switch to "production" + production
# credentials to go live. The NEXT_PUBLIC_ vars are read client-side by the
# Web Payments SDK card form and are safe to expose (they are not secrets).
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""

# Supabase Storage — sitter profile photo upload (src/lib/supabase.ts),
# server-side only (this app uses Auth.js, not Supabase Auth, so client-side
# RLS-based upload isn't viable). Bucket "sitter-avatars" must exist
# (public, 5MB cap, image/jpeg|png|webp only) — create it under
# Storage -> Buckets in the Supabase dashboard. NEXT_PUBLIC_SUPABASE_URL is
# safe client-side; SUPABASE_SERVICE_ROLE_KEY bypasses RLS and must stay
# server-only — get it from Settings -> API Keys -> Secret keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
